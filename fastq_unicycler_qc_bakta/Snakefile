# Reproducible workflow for the PTB_GWAS project with step-scoped experiments.
configfile: "config.yaml"

import re

DATASET_IDS = sorted(
    config["datasets"].keys(),
    key=lambda dataset_id: (
        0,
        int(str(dataset_id).split(".", 1)[0]),
        str(dataset_id),
    ) if str(dataset_id).split(".", 1)[0].isdigit() else (1, str(dataset_id)),
)

