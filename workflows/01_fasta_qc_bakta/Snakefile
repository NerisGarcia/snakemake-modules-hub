import os

with open(config["sample_file"]) as handle:
    samples = [line.strip() for line in handle if line.strip() and not line.lstrip().startswith("#")]
if not samples or len(samples) != len(set(samples)):
    raise ValueError("sample_file must contain unique sample IDs")
genomes = {
    sample: os.path.join(
        config["input_dir"], sample + config["input_extension"]
    )
    for sample in samples
}

# Genomes whose file is missing (e.g. failed download) are reported as FAIL instead of stopping the run
available_samples = [
    s for s in samples if os.path.isfile(genomes[s]) and os.path.getsize(genomes[s]) > 0
]

results_dir = config["genomics_results_dir"]
annotation_dir = f"{results_dir}/02_annotation/bakta"
qc_dir = f"{results_dir}/03_qc"
busco_output = f"{qc_dir}/BUSCO"
quast_output = f"{qc_dir}/QUAST"
checkm2_output = f"{qc_dir}/CheckM2"
summary_table = config["summary_table"]

wildcard_constraints:
    sample="[^/]+"

module bakta_module:
    snakefile: "../../modules/03_gene_annotation/bakta/Snakefile"
    config:
        {"sample_file": config["sample_file"], "input_dir": config["input_dir"],
         "input_extension": config["input_extension"],
         "out_dir": f"{results_dir}/02_annotation",
         "bakta_db": config["bakta_db"], "threads": config["threads"]["bakta"]}

module busco_module:
    snakefile: "../../modules/02_assembly/busco/Snakefile"
    config:
        {"sample_file": config["sample_file"], "input_dir": annotation_dir,
         "input_extension": ".fna", "out_dir": qc_dir,
         "busco_lineage": config["busco_lineage"], "threads": config["threads"]["busco"]}

module quast_module:
    snakefile: "../../modules/02_assembly/quast/Snakefile"
    config:
        {"sample_file": config["sample_file"], "input_dir": annotation_dir,
         "input_extension": ".fna", "out_dir": qc_dir,
         "threads": config["threads"]["quast"]}

module checkm2_module:
    snakefile: "../../modules/02_assembly/checkm2/Snakefile"
    config:
        {"sample_file": config["sample_file"], "input_dir": annotation_dir,
         "input_extension": ".fna", "out_dir": qc_dir,
         "checkm2_db": config["checkm2_db"], "threads": config["threads"]["checkm2"]}

use rule * from bakta_module exclude all as bakta_*
use rule * from busco_module exclude all as busco_*
use rule * from quast_module exclude all as quast_*
use rule * from checkm2_module exclude all as checkm2_*

step_targets = {
    "input": [genomes[s] for s in samples],
    "bakta": expand(f"{annotation_dir}/{{sample}}.gff3", sample=samples),
    "busco": expand(f"{busco_output}/{{sample}}_busco_short_summary.txt", sample=samples),
    "quast": expand(f"{quast_output}/{{sample}}.quast.transposed_report.tsv", sample=samples),
    "checkm2": expand(f"{checkm2_output}/{{sample}}/quality_report.tsv", sample=samples),
}

summary_inputs = (
    expand(f"{annotation_dir}/{{sample}}.gff3", sample=available_samples)
    + expand(f"{annotation_dir}/{{sample}}.fna", sample=available_samples)
    + expand(f"{busco_output}/{{sample}}_busco_short_summary.txt", sample=available_samples)
    + expand(f"{busco_output}/{{sample}}_busco_full_table.tsv", sample=available_samples)
    + expand(f"{quast_output}/{{sample}}.quast.transposed_report.tsv", sample=available_samples)
    + expand(f"{checkm2_output}/{{sample}}/quality_report.tsv", sample=available_samples)
)

rule all:
    default_target: True
    input:
        summary_table,
        summary_inputs

rule summary_table:
    input:
        summary_inputs
    output:
        summary_table
    run:
        write_summary_table()

def write_summary_table():
    summary_dir = os.path.dirname(summary_table)
    if summary_dir:
        os.makedirs(summary_dir, exist_ok=True)
    with open(summary_table, "w") as out:
        out.write("sample\t" + "\t".join(step_targets.keys()) + "\n")
        for index, sample in enumerate(samples):
            row = [sample]
            for step, step_paths in step_targets.items():
                path = step_paths[index]
                if step != "input" and sample not in available_samples:
                    row.append("FAIL")
                    continue
                row.append("OK" if os.path.exists(path) and os.path.getsize(path) > 0 else "FAIL")
            out.write("\t".join(row) + "\n")

onsuccess:
    write_summary_table()

onerror:
    write_summary_table()
