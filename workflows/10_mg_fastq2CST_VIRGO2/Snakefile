# 2. quality_control fastp _____________________________________________________________

rule fastp:
    input:
        r1 = f'{RAW_DIR}/{{sample}}.R1.fq.gz',
        r2 = f'{RAW_DIR}/{{sample}}.R2.fq.gz',

    output:
        r1 = f'{FASTP_DIR}/{{sample}}.fastp.R1.fq.gz',
        r2 = f'{FASTP_DIR}/{{sample}}.fastp.R2.fq.gz',
        un1 = f'{FASTP_DIR}/{{sample}}.fastp.unpaired.R1.fq.gz',
        un2 = f'{FASTP_DIR}/{{sample}}.fastp.unpaired.R2.fq.gz',
        json = f'{FASTP_DIR}/{{sample}}_report.json',
        html = f'{FASTP_DIR}/{{sample}}_report.html'
    params:
        miniLen = miniLen,
        sample = f'{FASTP_DIR}/{{sample}}'
    threads:
        config["fastp_threads"]
    conda:
        "virgo2_env"
    shell:
        """
        fastp \
        --in1 {input.r1} --in2 {input.r2} \
        --out1 {output.r1} --out2 {output.r2} \
         --unpaired1 {output.un1} --unpaired2 {output.un2} \
        --html {output.html} --json {output.json} \
        -w {threads} \
        --detect_adapter_for_pe \
        --trim_poly_g \
        --cut_right \
        --length_required {params.miniLen} \
        --cut_window_size 4 \
        --cut_mean_quality 12 
        """

rule fastp_report:
    input:
        json = f'{FASTP_DIR}/{{sample}}_report.json'

    output:
        tsv = f'{FASTP_DIR}/{{sample}}_report.tsv'
    params:
        delimiter = '\t'
    script:
        "scripts/fastp-json2csv.py"


rule cat_fastq_unpaired:
    input:
        un2 = f'{FASTP_DIR}/{{sample}}.fastp.unpaired.R2.fq.gz',
        un1 = f'{FASTP_DIR}/{{sample}}.fastp.unpaired.R1.fq.gz',

    output:
        un = f'{FASTP_DIR}/{{sample}}.fastp.unpaired.fq.gz'

    shell:
        """
        cat {input.un1} {input.un2} > {output.un}
        rm {input.un1} {input.un2}
        """


# 3. human removal with cleanifyer ________________________________________________


rule cleanifyer_paired:
    input:
        r1 = f'{FASTP_DIR}/{{sample}}.fastp.R1.fq.gz',
        r2 = f'{FASTP_DIR}/{{sample}}.fastp.R2.fq.gz'

    output:
        r1_clean = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean_1_keep.fq.gz',
        r2_clean = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean_2_keep.fq.gz'
    params:
        c_index = CLEANIFIER_INDEX,
        sample = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean'
    
    conda:
        "virgo2_env"    
    threads:
        config["cleanifier_threads"]

    shell:
        """
        cleanifier filter --index {params.c_index} -T {threads} --compression gz --compression-threads {threads} --compression-level 9 --threshold 0.5 --fastq {input.r1} --pairs {input.r2} --out {params.sample}

        """

rule cleanifyer_unpaired:
    input:
        un = f'{FASTP_DIR}/{{sample}}.fastp.unpaired.fq.gz'
    output:
        un_clean = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.unpaired_keep.fq.gz'
    params:
        c_index = CLEANIFIER_INDEX,
        sample = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.unpaired'
    conda:
        "virgo2_env"   
    threads:
        config["cleanifier_threads"]

    shell:
        """
        cleanifier filter --index {params.c_index} -T {threads} --compression gz --compression-threads {threads} --compression-level 9 --threshold 0.5 --fastq {input.un} --out {params.sample}
        """

rule change_cleanifier_names:
    input:
        r1_clean = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean_1_keep.fq.gz',
        r2_clean = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean_2_keep.fq.gz',
        un_clean = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.unpaired_keep.fq.gz'


    output:
        r1_clean_new = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.R1.fq.gz',
        r2_clean_new = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.R2.fq.gz',
        un_clean_new = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.unpaired.fq.gz'

    shell:
        """
        mv {input.r1_clean} {output.r1_clean_new}
        mv {input.r2_clean} {output.r2_clean_new}
        mv {input.un_clean} {output.un_clean_new}
        """

rule cleanifyer_analytics:
    input:
        r1_clean = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.R1.fq.gz',
        r2_clean = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.R2.fq.gz',
        un_clean = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.unpaired.fq.gz'

    output:
        analytics_dir = f'{CLEANIFIER_DIR}/qc/{{sample}}.fastp_clean.seqkit_stats.txt'

    params:
        sample =  f'{CLEANIFIER_DIR}/qc/{{sample}}.fastp_clean'
    conda:
        "virgo2_env"
    shell:
        """
        seqkit stats {input.r1_clean} {input.r2_clean} {input.un_clean} > {params.sample}.seqkit_stats.txt
        """


# 4a. merge paired end for VIRGO2_____________________________________________________________
rule se_for_virgo:
    input:
        r1_clean_new = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.R1.fq.gz',
        r2_clean_new = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.R2.fq.gz',
        un = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.unpaired.fq.gz'

    output:
        se = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.se.fq.gz'

    threads:
        config["virgo2_threads"]

    shell:
        """
        cat {input.r1_clean_new} {input.r2_clean_new} {input.un} > {output.se}
        """

# 4b. run VIRGO2 - mapping_____________________________________________________________

rule virgo2_map:
    input:
        se = f'{CLEANIFIER_DIR}/{{sample}}.fastp_clean.se.fq.gz'

    output:
        out = f'{VIRGO_DIR}/01_map/{{sample}}.out'

    threads:
        config["virgo2_threads"]
    
    params:
        sample = f'{VIRGO_DIR}/01_map/{{sample}}'
    conda:
        "virgo2_env"

    shell:
        """
       python /Users/ngarcia-gonzalez/Desktop/RESEARCH/snakemake-modules-hub/VIRGO2/VIRGO2.py map --bypass 0 --reads {input.se} --threads {threads} --outputPrefix {params.sample}
        """

# 4c. run VIRGO2 - compile_____________________________________________________________

rule virgo2_compile:
    input:
