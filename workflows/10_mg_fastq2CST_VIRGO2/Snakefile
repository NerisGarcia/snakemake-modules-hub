# 5a. CST with Valencia_____________________________________________________________

rule correc_virgo_taxa_names:
    input:
        in_virgo = f'{VIRGO_DIR}/03_taxonomy/{DATASET}.virgo2.readCount.csv'
    output:
        out = temp(f'{VIRGO_DIR}/03_taxonomy/{DATASET}.virgo2.readCount.taxacorrected.csv')

    params:
        taxa_names_to_change = VIRGOTAXA_TO_RENAME

    shell:
        """
        python {SCRIPTS_DIR}/virgo2_correct_taxa_names.py \
            -i {input.in_virgo} \
            -o {output.out} \
            -t {params.taxa_names_to_change}
        """

rule virgo2_add_read_count:
    #A read_count column was added as required by VALENCIA:
    input:
        in_virgo = f'{VIRGO_DIR}/03_taxonomy/{DATASET}.virgo2.readCount.taxacorrected.csv'

    output:
        out = f'{VIRGO_DIR}/03_taxonomy/{DATASET}.virgo2.readCount.VLC.csv'

    shell:
        """
        python {SCRIPTS_DIR}/virgo2_add_read_count.py \
            -i {input.in_virgo} \
            -o {output.out}
        """

rule valencia_cst:
    input:
        in_virgo =  f'{VIRGO_DIR}/03_taxonomy/{DATASET}.virgo2.readCount.VLC.csv'
    output:
        out = f'{VALENCIA_DIR}/{DATASET}_VALENCIA.csv'
    params:
        ref =  VLC_REF
    shell:
        """
        python Valencia.py \
            -ref {params.ref} \
            -i {input.in_virgo} \
            -o {output.out}
   """


# 6. mgCST with VISTA_____________________________________________________________

