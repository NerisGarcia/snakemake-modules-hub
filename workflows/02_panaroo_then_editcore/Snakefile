# Modules are fetched from GitHub so the workflow can run from any directory (e.g. a server).
REPO = "NerisGarcia/snakemake-modules-hub"
BRANCH = "main"

dataset_name = config["dataset_name"]
pangenome_dir = config["pangenome_dir"]
panaroo_config = config["panaroo"]
subcore_config = config.get("subcore") or {}
subsample_config = config.get("subsample") or {}
# Panaroo threshold; the edit step has its own and falls back to this one
threshold = panaroo_config["core_threshold"]
subcore_threshold = subcore_config.get("core_threshold") or threshold


def core_tag(value):
    return f"core_{round(float(value) * 100)}"


panaroo_run_name = panaroo_config.get("run_name") or f"panaroo_original.{core_tag(threshold)}"
panaroo_dir = f"{pangenome_dir}/{panaroo_run_name}"
core_list = subcore_config.get("core_sample_list") or None
analysis_list = subsample_config.get("analysis_sample_list") or None
SUBSET = bool(core_list or analysis_list)

# Folder name of the core_subset run, which gene_aln_cleaning writes into too:
#   core list only -> subcore, analysis list only -> subsamp, both -> subcore_subsamp
subset_prefix = "_".join(
    part for part in (
        "subcore" if core_list else "",
        "subsamp" if analysis_list else "",
    ) if part
)
subcore_label = subcore_config.get("label") or ""
subsample_label = subsample_config.get("label") or ""
if core_list and not subcore_label:
    raise ValueError("Set subcore.label to describe subcore.core_sample_list (e.g. 'isolates_only')")
if analysis_list and not subsample_label:
    raise ValueError("Set subsample.label to describe subsample.analysis_sample_list (e.g. 'cladeA1')")
label = "__".join(part for part in (subcore_label, subsample_label) if part)
subset_name = f"{subset_prefix}.{label}.{core_tag(subcore_threshold)}"
subset_dir = f"{pangenome_dir}/{subset_name}"
core_prefix = f"{panaroo_dir}/iqtree/{panaroo_run_name}.gene_alignment_filtered"
subset_tree_prefix = f"{subset_dir}/iqtree/{subset_name}.gene_alignment"

module_configs = {
    "panaroo": {
        **panaroo_config,
        "run_name": panaroo_run_name,
        "sample_list": config["sample_list"],
        "dataset_name": dataset_name,
        "annot_dir": config["annot_dir"],
        "pangenome_dir": pangenome_dir,
        "threads": config["threads"],
    },
    "core_subset": {
        "dataset_name": dataset_name,
        "sample_list": config["sample_list"],
        "pangenome_dir": pangenome_dir,
        "panaroo": {"run_name": panaroo_run_name},
        "subcore": {
            "core_sample_list": core_list,
            "core_threshold": subcore_threshold,
            "label": subcore_label,
        },
        "subsample": {
            "analysis_sample_list": analysis_list,
            "label": subsample_label,
        },
    },
    "gene_aln_cleaning": {
        "alignment_list": f"{subset_dir}/selected_alignments.txt",
        "sample_list": f"{subset_dir}/analysis_samples.txt",
        "output_dir": subset_dir,
        "prefix": subset_name,
        "threads": config["threads"],
        **config["gene_aln_cleaning"],
    },
    "core_iqtree": {
        **config["iqtree"],
        "alignment": f"{panaroo_dir}/core_gene_alignment_filtered.aln",
        "prefix": core_prefix,
        "threads": config["threads"],
    },
    "editcore_iqtree": {
        **config["iqtree"],
        "alignment": f"{subset_dir}/{subset_name}.gene_alignment.aln",
        "prefix": subset_tree_prefix,
        "threads": config["threads"],
    },
}

module panaroo:
    snakefile:
        github(REPO, path="modules/04_pangenome/panaroo/Snakefile", branch=BRANCH)
    config:
        module_configs["panaroo"]


module core_iqtree:
    snakefile:
        github(REPO, path="modules/05_phylogenetics/iqtree/Snakefile", branch=BRANCH)
    config:
        module_configs["core_iqtree"]


if SUBSET:
    module core_subset:
        snakefile:
            github(REPO, path="modules/04_pangenome/core_subset/Snakefile", branch=BRANCH)
        config:
            module_configs["core_subset"]


    module gene_aln_cleaning:
        snakefile:
            github(REPO, path="modules/04_pangenome/gene_aln_cleaning/Snakefile", branch=BRANCH)
        config:
            module_configs["gene_aln_cleaning"]


    module editcore_iqtree:
        snakefile:
            github(REPO, path="modules/05_phylogenetics/iqtree/Snakefile", branch=BRANCH)
        config:
            module_configs["editcore_iqtree"]


use rule * from panaroo exclude all as panaroo_*
use rule * from core_iqtree exclude all as core_iqtree_*

if SUBSET:
    use rule * from core_subset exclude all as core_subset_*
    use rule * from gene_aln_cleaning exclude all as gene_aln_cleaning_*
    use rule * from editcore_iqtree exclude all as editcore_iqtree_*


rule panaroo_core_all:
    input:
        f"{panaroo_dir}/gene_presence_absence.Rtab",
        f"{panaroo_dir}/gene_presence_absence_roary.csv",
        f"{panaroo_dir}/combined_DNA_CDS.fasta",
        f"{panaroo_dir}/core_gene_alignment.aln",
        f"{panaroo_dir}/core_gene_alignment_filtered.aln",
        f"{panaroo_dir}/aligned_gene_sequences",
        f"{panaroo_dir}/{panaroo_run_name}.pangenome_summary.tsv",
        f"{core_prefix}.treefile"


subset_targets = (
    [
        f"{subset_dir}/gene_presence_absence.selected_samples.csv",
        f"{subset_dir}/selected_core_groups.tsv",
        f"{subset_dir}/sample_selection.tsv",
        f"{subset_dir}/params.txt",
        f"{subset_dir}/{subset_name}.gene_alignment.aln",
        f"{subset_dir}/amas/{subset_name}.partitions.txt",
        f"{subset_dir}/amas/amas_alignment_summary.tsv",
        f"{subset_dir}/{subset_name}.pangenome_summary.tsv",
        f"{subset_tree_prefix}.treefile",
    ]
    if SUBSET
    else []
)


# Without subcore.core_sample_list/subsample.analysis_sample_list this is just the Panaroo stage.
rule all:
    default_target: True
    input:
        rules.panaroo_core_all.input,
        subset_targets
