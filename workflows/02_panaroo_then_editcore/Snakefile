# Edit-only workflow: it reads an existing Panaroo run (made by 02_panaroo_tree or the panaroo module)
dataset_name = config.get("dataset_name") or ""
subcore_config = config.get("subcore") or {}
subsample_config = config.get("subsample") or {}
subcore_threshold = subcore_config["core_threshold"]


def core_tag(value):
    return f"core_{round(float(value) * 100)}"


out_dir = config["out_dir"]
core_list = subcore_config.get("core_sample_list") or None
analysis_list = subsample_config.get("analysis_sample_list") or None
if not (core_list or analysis_list):
    raise ValueError("Set subcore.core_sample_list and/or subsample.analysis_sample_list")

# Folder name of the core_subset run, which gene_aln_cleaning writes into too:
#   core list only -> subcore, analysis list only -> subsamp, both -> subcore_subsamp
subset_prefix = "_".join(
    part for part in (
        "subcore" if core_list else "",
        "subsamp" if analysis_list else "",
    ) if part
)
subcore_label = subcore_config.get("label") or ""
subsample_label = subsample_config.get("label") or ""
if core_list and not subcore_label:
    raise ValueError("Set subcore.label to describe subcore.core_sample_list (e.g. 'isolates_only')")
if analysis_list and not subsample_label:
    raise ValueError("Set subsample.label to describe subsample.analysis_sample_list (e.g. 'cladeA1')")
label = "__".join(part for part in (subcore_label, subsample_label) if part)
subset_name = f"{subset_prefix}.{label}.{core_tag(subcore_threshold)}"
subset_dir = f"{out_dir}/core_subset/{subset_name}"
alignment_dir = f"{out_dir}/gene_aln_cleaning/{subset_name}"
subset_tree_prefix = f"{out_dir}/iqtree/{subset_name}.gene_alignment"

module_configs = {
    "core_subset": {
        "dataset_name": dataset_name,
        "out_dir": out_dir,
        "panaroo": config["panaroo"],
        "subcore": {
            "core_sample_list": core_list,
            "core_threshold": subcore_threshold,
            "label": subcore_label,
        },
        "subsample": {
            "analysis_sample_list": analysis_list,
            "label": subsample_label,
        },
    },
    "gene_aln_cleaning": {
        "alignment_list": f"{subset_dir}/selected_alignments.txt",
        "sample_file": f"{subset_dir}/analysis_samples.txt",
        "out_dir": out_dir,
        "prefix": subset_name,
        "threads": config["threads"]["mafft"],
        **config["gene_aln_cleaning"],
    },
    "editcore_iqtree": {
        **config["iqtree"],
        "input_file": f"{alignment_dir}/{subset_name}.gene_alignment.aln",
        "out_dir": out_dir,
        "prefix": f"{subset_name}.gene_alignment",
        "threads": config["threads"]["iqtree"],
        "prepare_threads": config["threads"]["snp_dists"],
    },
}

module core_subset:
    snakefile:
        "../../modules/04_pangenome/core_subset/Snakefile"
    config:
        module_configs["core_subset"]


module gene_aln_cleaning:
    snakefile:
        "../../modules/04_pangenome/gene_aln_cleaning/Snakefile"
    config:
        module_configs["gene_aln_cleaning"]


module editcore_iqtree:
    snakefile:
        "../../modules/05_phylogenetics/iqtree/Snakefile"
    config:
        module_configs["editcore_iqtree"]


use rule * from core_subset exclude all as core_subset_*
use rule * from gene_aln_cleaning exclude all as gene_aln_cleaning_*
use rule * from editcore_iqtree exclude all as editcore_iqtree_*


rule all:
    default_target: True
    input:
        f"{subset_dir}/gene_presence_absence.selected_samples.csv",
        f"{subset_dir}/selected_core_groups.tsv",
        f"{subset_dir}/sample_selection.tsv",
        f"{subset_dir}/params.txt",
        f"{alignment_dir}/{subset_name}.gene_alignment.aln",
        f"{alignment_dir}/amas/{subset_name}.partitions.txt",
        f"{alignment_dir}/amas/amas_alignment_summary.tsv",
        f"{subset_dir}/{subset_name}.pangenome_summary.tsv",
        f"{subset_tree_prefix}.treefile",
