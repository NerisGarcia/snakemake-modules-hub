import os

with open(config["sra_acc_list"]) as handle:
    samples = [
        line.strip()
        for line in handle
        if line.strip() and not line.lstrip().startswith("#")
    ]

if not samples:
    raise ValueError("The SRA accession list is empty")

raw_dir = config["sra_raw"]
samples_with_inputs = {
    sample
    for sample in samples
    if all(
        os.path.isfile(path) and os.path.getsize(path) > 0
        for path in (
            f"{raw_dir}/{sample}_1.fastq.gz",
            f"{raw_dir}/{sample}_2.fastq.gz",
        )
    )
}
available_samples = [sample for sample in samples if sample in samples_with_inputs]
clean_dir = f"{config['clean_dir']}/fastp"
results_dir = config["genomics_results_dir"]
kraken_dir = f"{results_dir}/kraken2"
assembly_dir = f"{results_dir}/01_assembly/shovill"
annotation_dir = f"{results_dir}/02_annotation/bakta"
qc_dir = f"{results_dir}/03_qc"
busco_output = f"{qc_dir}/BUSCO"
quast_output = f"{qc_dir}/QUAST"
checkm2_output = f"{qc_dir}/CheckM2"
summary_table = config["summary_table"]

module_configs = {
    "fastp": {
        "sample_file": config["sra_acc_list"],
        "raw_dir": raw_dir,
        "pairend_extension_pattern": "_{read}",
        "input_extension": ".fastq.gz",
        "out_dir": config["clean_dir"],
        "fastp": config["fastp"],
        "threads": config["threads"]["fastp"],
    },
    "kraken2": {
        "sample_file": config["sra_acc_list"],
        "raw_dir": clean_dir,
        "pairend_extension_pattern": ".fastp.R{read}",
        "input_extension": ".fastq.gz",
        "out_dir": results_dir,
        "kraken_db": config["kraken_db"],
        "threads": config["threads"]["kraken2"],
        "bracken_read_len": config["bracken_read_len"],
        "bracken_level": config["bracken_level"],
        "bracken_threshold": config["bracken_threshold"],
    },
    "shovill": {
        "sample_file": config["sra_acc_list"],
        "raw_dir": clean_dir,
        "pairend_extension_pattern": ".fastp.R{read}",
        "input_extension": ".fastq.gz",
        "out_dir": f"{results_dir}/01_assembly",
        "threads": config["threads"]["shovill"],
    },
    "bakta": {
        "sample_file": config["sra_acc_list"],
        "raw_dir": assembly_dir,
        "input_extension": ".contigs.fa",
        "out_dir": f"{results_dir}/02_annotation",
        "bakta_db": config["bakta_db"],
        "threads": config["threads"]["bakta"],
    },
    "busco": {
        "sample_file": config["sra_acc_list"],
        "raw_dir": annotation_dir,
        "input_extension": ".fna",
        "out_dir": qc_dir,
        "busco_lineage": config["busco_lineage"],
        "threads": config["threads"]["busco"],
    },
    "quast": {
        "sample_file": config["sra_acc_list"],
        "raw_dir": annotation_dir,
        "input_extension": ".fna",
        "out_dir": qc_dir,
        "threads": config["threads"]["quast"],
    },
    "checkm2": {
        "sample_file": config["sra_acc_list"],
        "raw_dir": annotation_dir,
        "input_extension": ".fna",
        "out_dir": qc_dir,
        "checkm2_db": config["checkm2_db"],
        "threads": config["threads"]["checkm2"],
    },
}

module fastp_module:
    snakefile:
        "../../modules/01_read_preprocessing/fastp/Snakefile"
    config:
        module_configs["fastp"]


module kraken2_module:
    snakefile:
        "../../modules/01_read_preprocessing/kraken2/Snakefile"
    config:
        module_configs["kraken2"]


module shovill_module:
    snakefile:
        "../../modules/02_assembly/shovill/Snakefile"
    config:
        module_configs["shovill"]


module bakta_module:
    snakefile:
        "../../modules/03_gene_annotation/bakta/Snakefile"
    config:
        module_configs["bakta"]


module busco_module:
    snakefile:
        "../../modules/02_assembly/busco/Snakefile"
    config:
        module_configs["busco"]


module quast_module:
    snakefile:
        "../../modules/02_assembly/quast/Snakefile"
    config:
        module_configs["quast"]


module checkm2_module:
    snakefile:
        "../../modules/02_assembly/checkm2/Snakefile"
    config:
        module_configs["checkm2"]


use rule * from fastp_module exclude all as fastp_*
use rule * from kraken2_module exclude all as kraken2_*
use rule * from shovill_module exclude all as shovill_*
use rule * from bakta_module exclude all as bakta_*
use rule * from busco_module exclude all as busco_*
use rule * from quast_module exclude all as quast_*
use rule * from checkm2_module exclude all as checkm2_*

step_targets = {
    "input_r1": expand(f"{raw_dir}/{{sample}}_1.fastq.gz", sample=samples),
    "input_r2": expand(f"{raw_dir}/{{sample}}_2.fastq.gz", sample=samples),
    "fastp": expand(f"{clean_dir}/{{sample}}_report.json", sample=samples),
    "kraken2": expand(
        f"{kraken_dir}/{{sample}}_kraken2_report.txt", sample=samples
    ),
    "bracken": expand(f"{kraken_dir}/{{sample}}_bracken_{config['bracken_level']}.tsv", sample=samples),
    "shovill": expand(
        f"{assembly_dir}/{{sample}}.contigs.fa", sample=samples
    ),
    "bakta": expand(f"{annotation_dir}/{{sample}}_bakta/{{sample}}.gff3", sample=samples),
    "busco": expand(
        f"{busco_output}/{{sample}}_busco_short_summary.txt", sample=samples
    ),
    "quast": expand(
        f"{quast_output}/{{sample}}.quast.transposed_report.tsv", sample=samples
    ),
    "checkm2": expand(
        f"{checkm2_output}/{{sample}}/quality_report.tsv", sample=samples
    ),
}

summary_inputs = [
    path
    for step, paths in step_targets.items()
    if step not in {"input_r1", "input_r2"}
    for sample, path in zip(samples, paths)
    if sample in samples_with_inputs
]
summary_inputs += (
    expand(f"{clean_dir}/{{sample}}.fastp.R1.fastq.gz", sample=available_samples)
    + expand(f"{clean_dir}/{{sample}}.fastp.R2.fastq.gz", sample=available_samples)
    + expand(f"{clean_dir}/{{sample}}_report.html", sample=available_samples)
    + expand(f"{annotation_dir}/{{sample}}.fna", sample=available_samples)
    + expand(f"{busco_output}/{{sample}}_busco_full_table.tsv", sample=available_samples)
)


rule all:
    default_target: True
    input:
        summary_table,
        summary_inputs


rule summary_table:
    input:
        summary_inputs
    output:
        summary_table
    run:
        write_summary_table()


def write_summary_table():
    summary_dir = os.path.dirname(summary_table)
    if summary_dir:
        os.makedirs(summary_dir, exist_ok=True)
    with open(summary_table, "w") as out:
        out.write("sample\t" + "\t".join(step_targets.keys()) + "\n")
        for index, sample in enumerate(samples):
            row = [sample]
            for step, paths in step_targets.items():
                path = paths[index]
                if (
                    step not in {"input_r1", "input_r2"}
                    and sample not in samples_with_inputs
                ):
                    row.append("FAIL")
                    continue
                row.append(
                    "OK"
                    if os.path.exists(path) and os.path.getsize(path) > 0
                    else "FAIL"
                )
            out.write("\t".join(row) + "\n")


onsuccess:
    write_summary_table()

onerror:
    write_summary_table()
