import os

SAMPLE_FILE = config["sample_list"]

with open(SAMPLE_FILE) as handle:
    SAMPLES = [
        line.strip()
        for line in handle
        if line.strip() and not line.lstrip().startswith("#")
    ]

if not SAMPLES:
    raise ValueError("The isolate sample list is empty")

ANNOT_DIR = config["annot_dir"]
RESULTS_DIR = config["genomics_results_dir"]
DATASET_NAME = config["dataset_name"]
CORE_DIR = f"{RESULTS_DIR}/04_pangenome/{DATASET_NAME}"
CORE_THRESHOLD = config["panaroo"]["core_threshold"]
PANAROO_DIR = f"{CORE_DIR}/core_{CORE_THRESHOLD}"
CORE_PREFIX = f"core{CORE_THRESHOLD}"

GFF_PATHS = f"{CORE_DIR}/gff_paths.txt"
IQTREE_PREFIX = f"{PANAROO_DIR}/iqtree/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered"


rule all:
    input:
        f"{PANAROO_DIR}/gene_presence_absence.Rtab",
        f"{PANAROO_DIR}/gene_presence_absence_roary.csv",
        f"{IQTREE_PREFIX}.treefile"


# PANGENOME ——————————————————————————————————————————————————————————————

rule edit_gff_to_remove_gene:
    input:
        gff=ancient(f"{ANNOT_DIR}/{{isolate}}.gff3")
    output:
        edited_gff=f"{CORE_DIR}/edited/{{isolate}}.gff3"
    shell:
        r'''
        mkdir -p $(dirname {output.edited_gff})
        sed 's/;gene=[^;]*//' {input.gff} > {output.edited_gff}
        '''


rule pangenome_gff_paths:
    input:
        edited_gffs=expand(f"{CORE_DIR}/edited/{{isolate}}.gff3", isolate=SAMPLES)

    output:
        GFF_PATHS
    shell:
        r'''
        out_dir=$(dirname {output})
        mkdir -p "$out_dir"
        printf '%s\n' {input.edited_gffs} > {output}
        '''

rule pangenome_panaroo:
    input:
        gff_paths=GFF_PATHS
    output:
        gene_presence_absence = f"{PANAROO_DIR}/gene_presence_absence.Rtab",
        core_alignment      = f"{PANAROO_DIR}/core_gene_alignment.aln",
        core_aln_filtered   = f"{PANAROO_DIR}/core_gene_alignment_filtered.aln",
        core_aln_filtered_head= f"{PANAROO_DIR}/core_alignment_filtered_header.embl",
        core_aln_head     = f"{PANAROO_DIR}/core_alignment_header.embl",
        pangenome = f"{PANAROO_DIR}/gene_presence_absence_roary.csv",

    params:
        out_dir = PANAROO_DIR,
        clean_mode=config["panaroo"]["clean_mode"],
        alignment=config["panaroo"]["alignment"],
        family_threshold=config["panaroo"]["family_threshold"],
        core_threshold=CORE_THRESHOLD,
        refind_mode=config["panaroo"]["refind_mode"],
        aligner=config["panaroo"]["aligner"],
    threads: config["threads"]
    conda:
        "panaroo_env"
    shell:
        r'''
        mkdir -p {params.out_dir}

        panaroo \
          -i $(cat {input.gff_paths}) \
          -o {params.out_dir} \
          --clean-mode {params.clean_mode} \
          --remove-invalid-genes \
          -a {params.alignment} \
          --family_threshold {params.family_threshold} \
          --core_threshold {params.core_threshold} \
          --merge_paralogs \
          --refind-mode {params.refind_mode} \
          --aligner {params.aligner} \
          --threads {threads}
 
       '''


rule rename_core_files:
    input:
        core_alignment=f"{PANAROO_DIR}/core_gene_alignment.aln",
        core_aln_filtered=f"{PANAROO_DIR}/core_gene_alignment_filtered.aln",
        core_aln_filtered_head=f"{PANAROO_DIR}/core_alignment_filtered_header.embl",
        core_aln_head=f"{PANAROO_DIR}/core_alignment_header.embl"
    output:
        core_alignment=f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment.aln",
        core_aln_filtered=f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered.aln",
        core_aln_filtered_head=f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.alignment_filtered_header.embl",
        core_aln_head=f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.alignment_header.embl"
    shell:
        r'''
        mv {input.core_alignment} {output.core_alignment}
        mv {input.core_aln_filtered} {output.core_aln_filtered}
        mv {input.core_aln_filtered_head} {output.core_aln_filtered_head}
        mv {input.core_aln_head} {output.core_aln_head}
        '''

rule prepare_tree_filtered:
    input:
        core_aln_filtered  = f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered.aln",    
    output:
        vcf = f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered.vcf",
        dist =  f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered.fasta.DM",
        snp_fasta = f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered.SNPs.fasta",
        fconts_file = f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered.fconst.txt",
    conda:
        "panaroo_env"
    threads: config["threads"]
    shell:
        r'''
          
        snp-sites -v {input.core_aln_filtered} > {output.vcf}

        snp-dists -j {threads} -m {input.core_aln_filtered} > {output.dist}

        snp-sites -o {output.snp_fasta} {input.core_aln_filtered}

        fconstsvar=$(snp-sites -C {input.core_aln_filtered})

        echo $fconstsvar > {output.fconts_file}

        '''


rule iqtree_tree_filtered:
    input:
        snp_fasta = f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered.SNPs.fasta",
        fconts_file = f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered.fconst.txt",
    output:
        tree_file =  f"{IQTREE_PREFIX}.treefile"
    conda:
        "panaroo_env"
    params:
        model = config["iqtree"]["model"],
        bootstrap = config["iqtree"]["bootstrap"],
        threads = config["threads"],
        prefix = f"{IQTREE_PREFIX}"

    shell:
        r'''
        fconstsvar=$(cat {input.fconts_file})
        iqtree -s {input.snp_fasta} -m {params.model} -B {params.bootstrap} -nt {params.threads} --redo -fconst $fconstsvar --prefix {params.prefix}

        '''
