with open(config["genome_acc_list"]) as handle:
    SAMPLES = [
        line.strip()
        for line in handle
        if line.strip() and not line.lstrip().startswith("#")
    ]

if not SAMPLES:
    raise ValueError("The genome accession list is empty")

ASS_DIR = config["ass_dir"]
RESULTS_DIR = config["genomics_results_dir"]
ANN_DIR = f"{RESULTS_DIR}/02_annotation"
QC_DIR = f"{RESULTS_DIR}/03_qc"
BAKTA_DB_DIR = config["bakta_db"]

BUSCO_OUTPUT =  f"{QC_DIR}/BUSCO"
BUSCO_LINEAGE = config["busco_lineage"]
QUAST_OUTPUT = f"{QC_DIR}/QUAST"
SUMMARY_TABLE = config["summary_table"]

# expected final output per sample for each step, used only by the summary table
# "input" flags samples whose assembly is missing because the download step upstream failed
STEP_TARGETS = {
    "input": expand(f"{ASS_DIR}/{{sample}}.fna", sample=SAMPLES),
    "bakta": expand(f"{ANN_DIR}/{{sample}}_bakta/{{sample}}.gff3", sample=SAMPLES),
    "busco": expand(f"{BUSCO_OUTPUT}/{{sample}}_busco_short_summary.txt", sample=SAMPLES),
    "quast": expand(f"{QUAST_OUTPUT}/{{sample}}.quast.transposed_report.tsv", sample=SAMPLES),
}
rule all:
    input:
        expand(f"{ANN_DIR}/{{sample}}_bakta/{{sample}}.gff3", sample=SAMPLES),
        expand(f"{ANN_DIR}/{{sample}}_bakta/{{sample}}.fna", sample=SAMPLES),
        expand(f"{BUSCO_OUTPUT}/{{sample}}_busco_short_summary.txt", sample=SAMPLES),
        expand(f"{BUSCO_OUTPUT}/{{sample}}_busco_full_table.tsv", sample=SAMPLES),
        expand(f"{QUAST_OUTPUT}/{{sample}}.quast.transposed_report.tsv", sample=SAMPLES)

rule bakta:
    input:
        contigs=f"{ASS_DIR}/{{sample}}.fna"
    output:
        gff3=f"{ANN_DIR}/{{sample}}_bakta/{{sample}}.gff3",
        fna=f"{ANN_DIR}/{{sample}}_bakta/{{sample}}.fna"
    params:
        out_dir=f"{ANN_DIR}/{{sample}}_bakta",
        prefix="{sample}",
        bakta_db=BAKTA_DB_DIR
    threads: config["threads"]["bakta"]
    conda:
        "genomics_env"
    shell:
        """
        mkdir -p {params.out_dir}
        bakta --db {params.bakta_db} --output {params.out_dir} \
            --prefix {params.prefix} --locus-tag {params.prefix} \
            --threads {threads} {input.contigs} --keep-contig-headers --force
        """


rule busco:
    input:
        f"{ANN_DIR}/{{sample}}_bakta/{{sample}}.fna"
    output:
        out2 =  f"{BUSCO_OUTPUT}/{{sample}}_busco_short_summary.txt",
        out4 =  f"{BUSCO_OUTPUT}/{{sample}}_busco_full_table.tsv"
    params:
        out_dir = f"{BUSCO_OUTPUT}",
        out1 =  f"{BUSCO_OUTPUT}/{{sample}}/short_summary.specific.{BUSCO_LINEAGE}.{{sample}}.txt",
        out2 =  f"{BUSCO_OUTPUT}/{{sample}}_busco_short_summary.txt",
        
        out3 =  f"{BUSCO_OUTPUT}/{{sample}}/run_{BUSCO_LINEAGE}/full_table.tsv",
        out4 =  f"{BUSCO_OUTPUT}/{{sample}}_busco_full_table.tsv",

        sample = f"{{sample}}",
        lineage = BUSCO_LINEAGE

    threads: 8
    conda:
        "genomics_env"
    shell:
        """
        busco -i {input} -o {params.sample} -l {params.lineage} -m genome --out_path {params.out_dir} --force --cpu {threads} 
        mv  {params.out1} {params.out2}
        mv {params.out3} {params.out4}
        """


rule assembly_qc_sample:
    input:
        f"{ANN_DIR}/{{sample}}_bakta/{{sample}}.fna"
    output:
        f"{QUAST_OUTPUT}/{{sample}}.quast.transposed_report.tsv"
    conda:
        "quast_full_env"
    params:
        out_dir = f"{QUAST_OUTPUT}/{{sample}}_quast"
    threads: 16
    shell:
        r'''
        quast.py {input} -o {params.out_dir} --threads {threads} --glimmer --no-sv --no-icarus --no-plots --min-contig 200

        mv {params.out_dir}/transposed_report.tsv {output}
        rm -rf {params.out_dir}
        '''


# runs after the DAG finishes (success or --keep-going with failures) in the same invocation
def write_summary_table():
    import os
    summary_dir = os.path.dirname(SUMMARY_TABLE)
    if summary_dir:
        os.makedirs(summary_dir, exist_ok=True)
    with open(SUMMARY_TABLE, "w") as out:
        out.write("sample\t" + "\t".join(STEP_TARGETS.keys()) + "\n")
        for i, sample in enumerate(SAMPLES):
            row = [sample]
            for paths in STEP_TARGETS.values():
                path = paths[i]
                row.append("OK" if os.path.exists(path) and os.path.getsize(path) > 0 else "FAIL")
            out.write("\t".join(row) + "\n")

onsuccess:
    write_summary_table()

onerror:
    write_summary_table()
