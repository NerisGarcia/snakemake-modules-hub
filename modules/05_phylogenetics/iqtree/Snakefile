alignment = config["alignment"]
prefix = config["prefix"]
log_dir = f"{prefix}_logs"
model = config["model"]
bootstrap = config["bootstrap"]
fast_flag = "--fast" if config.get("fast", False) else ""


rule all:
    input:
        f"{prefix}.treefile"


rule prepare_tree:
    input:
        alignment=alignment
    output:
        vcf=f"{prefix}.vcf",
        dist=f"{prefix}.fasta.DM",
        snp_fasta=f"{prefix}.SNPs.fasta",
        fconst_file=f"{prefix}.fconst.txt"
    threads: config["threads"]
    log:
        f"{log_dir}/prepare_tree.log"
    params:
        prefix=prefix
    conda:
        "environment.yaml"
    shell:
        r"""
        mkdir -p "$(dirname "{params.prefix}")"
        (
        snp-sites -v {input.alignment} > {output.vcf}
        snp-dists -j {threads} -m {input.alignment} > {output.dist}
        snp-sites -o {output.snp_fasta} {input.alignment}
        snp-sites -C {input.alignment} > {output.fconst_file}
        ) 2> {log}
        """


rule iqtree_tree:
    input:
        snp_fasta=f"{prefix}.SNPs.fasta",
        fconst_file=f"{prefix}.fconst.txt"
    output:
        tree_file=f"{prefix}.treefile",
        report=f"{prefix}.iqtree"
    params:
        model=model,
        bootstrap=bootstrap,
        fast=fast_flag,
        prefix=prefix
    threads: config["threads"]
    log:
        f"{log_dir}/iqtree.log"
    conda:
        "environment.yaml"
    shell:
        r"""
        mkdir -p "$(dirname "{params.prefix}")"
        fconstsvar=$(cat "{input.fconst_file}")
        iqtree -s "{input.snp_fasta}" -m "{params.model}" -B "{params.bootstrap}" {params.fast} \
            -nt {threads} --redo -fconst "$fconstsvar" --prefix "{params.prefix}" > {log} 2>&1
        rm -f "{params.prefix}.ckp.gz"
        """
