

DATASET = config["dataset_name"]
with open(config["sample_file"]) as handle:
    SAMPLES = [line.strip() for line in handle if line.strip() and not line.lstrip().startswith("#")]
if not SAMPLES or len(SAMPLES) != len(set(SAMPLES)):
    raise ValueError("sample_file must contain unique sample IDs")

INPUT_DIR = config["input_dir"]
READ_PATTERN = config["pairend_extension_pattern"]
EXTENSION = config["input_extension"]
UNPAIRED_PATTERN = config.get("unpaired_input_pattern")
VIRGO2_DIR = f'{config["out_dir"]}/VIRGO2'
VIRGO2_SCRIPT = config["virgo2_script"]
if "{read}" not in READ_PATTERN:
    raise ValueError("pairend_extension_pattern must contain {read}")
if UNPAIRED_PATTERN and "{sample}" not in UNPAIRED_PATTERN:
    raise ValueError("unpaired_input_pattern must contain {sample}")


def unpaired_input(wildcards):
    if not UNPAIRED_PATTERN:
        return []
    return [f"{INPUT_DIR}/{UNPAIRED_PATTERN.format(sample=wildcards.sample)}{EXTENSION}"]


rule all:
    input:
        expand(f'{VIRGO2_DIR}/01_map/{{sample}}.VOG_counts.out', sample=SAMPLES),
        f'{VIRGO2_DIR}/03_taxonomy/{DATASET}.relAbund.csv',
        f'{VIRGO2_DIR}/03_taxonomy/{DATASET}.readCount.csv'


# 4a. merge paired end for VIRGO2_____________________________________________________________
rule se_for_virgo:
    input:
        r1 = f"{INPUT_DIR}/{{sample}}{READ_PATTERN.replace('{read}', '1')}{EXTENSION}",
        r2 = f"{INPUT_DIR}/{{sample}}{READ_PATTERN.replace('{read}', '2')}{EXTENSION}",
        un = unpaired_input

    output:
        se = f'{VIRGO2_DIR}/reads/{{sample}}.se{EXTENSION}'

    threads:
        config["threads"]

    shell:
        """
        cat {input:q} > {output.se:q}
        """

# 4b. run VIRGO2 - mapping_____________________________________________________________

rule virgo2_map:
    input:
        se = f'{VIRGO2_DIR}/reads/{{sample}}.se{EXTENSION}'

    output:
        out = f'{VIRGO2_DIR}/01_map/{{sample}}.VOG_counts.out'

    threads:
        config["threads"]
    
    params:
        sample = f'{VIRGO2_DIR}/01_map/{{sample}}.VOG_counts'
    conda:
        "environment.yaml"

    shell:
        """
       python {VIRGO2_SCRIPT:q} map --bypass 0 --reads {input.se:q} --threads {threads} --outputPrefix {params.sample:q}
        """

# 4c. run VIRGO2 - compile_____________________________________________________________

rule virgo2_compile:
    input:
        maps = expand(f'{VIRGO2_DIR}/01_map/{{sample}}.VOG_counts.out', sample=SAMPLES)

    output:
         out = f'{VIRGO2_DIR}/02_compile/{DATASET}.summary.NR.txt'

    threads:
        config["threads"]

    params:
        sample =f'{VIRGO2_DIR}/02_compile/{DATASET}',
        v_dir = f'{VIRGO2_DIR}/01_map'

    conda:
        "environment.yaml"
    shell:
        """
        python {VIRGO2_SCRIPT:q} compile -i {params.v_dir:q} --outputPrefix {params.sample:q}
        """

# 4d. run VIRGO2 - taxonomy __________________________________________________________

rule virgo2_taxonomy:
    input:
        in_comp = f'{VIRGO2_DIR}/02_compile/{DATASET}.summary.NR.txt'

    output:
        out = temp(f'{VIRGO2_DIR}/03_taxonomy/TEMP.{DATASET}.relAbund.csv')

    threads:
        config["threads"]

    params:
        sample = f'{VIRGO2_DIR}/03_taxonomy/TEMP.{DATASET}'

    conda:
        "environment.yaml"
    shell:
        """
        python {VIRGO2_SCRIPT:q} taxonomy -i {input.in_comp:q} --outputPrefix {params.sample:q}
        """

rule virgo2_taxonomy_counts:
    input:
        in_comp = f'{VIRGO2_DIR}/02_compile/{DATASET}.summary.NR.txt'

    output:
        out = temp(f'{VIRGO2_DIR}/03_taxonomy/TEMP.{DATASET}.readCount.csv')

    threads:
        config["threads"]

    params:
        sample = f'{VIRGO2_DIR}/03_taxonomy/TEMP.{DATASET}'

    conda:
        "environment.yaml"
    shell:
        """
        python {VIRGO2_SCRIPT:q} taxonomy -i {input.in_comp:q} --outputPrefix {params.sample:q} --readCounts 1
        """

rule change_VBAB_name:
    input:
        taxonomy = f'{VIRGO2_DIR}/03_taxonomy/TEMP.{DATASET}.relAbund.csv',
        readcount = f'{VIRGO2_DIR}/03_taxonomy/TEMP.{DATASET}.readCount.csv'
    output:
        taxonomy = f'{VIRGO2_DIR}/03_taxonomy/{DATASET}.relAbund.csv',
        readcount = f'{VIRGO2_DIR}/03_taxonomy/{DATASET}.readCount.csv'
    threads:
        config["threads"]

    shell:
        """
        sed 's/UBA629_sp005465875/Candidatus_Lachnocurva_vaginae/g' {input.taxonomy:q} > {output.taxonomy:q}
        sed 's/UBA629_sp005465875/Candidatus_Lachnocurva_vaginae/g' {input.readcount:q} > {output.readcount:q}

        """
