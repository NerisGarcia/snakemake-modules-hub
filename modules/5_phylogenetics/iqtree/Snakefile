    input:
        rtab=f"{PANAROO_DIR}/gene_presence_absence.Rtab",
        alignment=f"{PANAROO_DIR}/{DATASET_NAME}.{CORE_PREFIX}.gene_alignment_filtered.aln"
    output:
        summary=SUMMARY_FILE
