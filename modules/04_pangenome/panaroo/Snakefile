SAMPLE_FILE = config["sample_list"]

with open(SAMPLE_FILE) as handle:
    SAMPLES = [
        line.strip()
        for line in handle
        if line.strip() and not line.lstrip().startswith("#")
    ]

if not SAMPLES:
    raise ValueError("The isolate sample list is empty")

annot_dir = config["annot_dir"]
pangenome_dir = config["pangenome_dir"]
core_threshold = config["core_threshold"]
panaroo_dir = f"{pangenome_dir}/core_{core_threshold}"
log_dir = f"{panaroo_dir}/logs"
gff_paths = f"{pangenome_dir}/gff_paths.txt"
summary_file = f"{panaroo_dir}/{config['dataset_name']}.core{core_threshold}.pangenome_summary.tsv"


rule all:
    input:
        f"{panaroo_dir}/gene_presence_absence.Rtab",
        f"{panaroo_dir}/gene_presence_absence_roary.csv",
        summary_file


rule edit_gff_to_remove_gene:
    input:
        gff=ancient(f"{annot_dir}/{{isolate}}.gff3")
    output:
        edited_gff=temp(f"{pangenome_dir}/edited/{{isolate}}.gff3")
    log:
        f"{log_dir}/edit_gff/{{isolate}}.log"
    shell:
        r'''
        mkdir -p $(dirname {output.edited_gff}) $(dirname {log})
        sed 's/;gene=[^;]*//' {input.gff} > {output.edited_gff} 2> {log}
        '''


rule pangenome_gff_paths:
    input:
        edited_gffs=expand(f"{pangenome_dir}/edited/{{isolate}}.gff3", isolate=SAMPLES)
    output:
        gff_paths
    shell:
        r'''
        mkdir -p $(dirname {output})
        printf '%s\n' {input.edited_gffs} > {output}
        '''


rule pangenome_panaroo:
    input:
        gff_paths=gff_paths,
        edited_gffs=expand(f"{pangenome_dir}/edited/{{isolate}}.gff3", isolate=SAMPLES)
    output:
        gene_presence_absence=f"{panaroo_dir}/gene_presence_absence.Rtab",
        core_alignment=f"{panaroo_dir}/core_gene_alignment.aln",
        core_aln_filtered=f"{panaroo_dir}/core_gene_alignment_filtered.aln",
        core_aln_filtered_head=f"{panaroo_dir}/core_alignment_filtered_header.embl",
        core_aln_head=f"{panaroo_dir}/core_alignment_header.embl",
        pangenome=f"{panaroo_dir}/gene_presence_absence_roary.csv",
        combined_cds=f"{panaroo_dir}/combined_DNA_CDS.fasta",
        gene_sequences=directory(f"{panaroo_dir}/aligned_gene_sequences")
    params:
        out_dir=panaroo_dir,
        clean_mode=config["clean_mode"],
        alignment=config["alignment"],
        family_threshold=config["family_threshold"],
        core_threshold=core_threshold,
        refind_mode=config["refind_mode"],
        aligner=config["aligner"]
    threads: config["threads"]
    log:
        f"{log_dir}/panaroo.log"
    conda:
        "environment.yaml"
    shell:
        r'''
        mkdir -p {params.out_dir}
        panaroo \
          -i $(cat {input.gff_paths}) \
          -o {params.out_dir} \
          --clean-mode {params.clean_mode} \
          --remove-invalid-genes \
          -a {params.alignment} \
          --family_threshold {params.family_threshold} \
          --core_threshold {params.core_threshold} \
          --merge_paralogs \
          --refind-mode {params.refind_mode} \
          --aligner {params.aligner} \
          --threads {threads} > {log} 2>&1
        '''


rule pangenome_summary:
    input:
        rtab=f"{panaroo_dir}/gene_presence_absence.Rtab",
        alignment=f"{panaroo_dir}/core_gene_alignment_filtered.aln"
    output:
        summary=summary_file
    params:
        core_threshold=core_threshold
    log:
        f"{log_dir}/pangenome_summary.log"
    script:
        "scripts/pangenome_summary.py"
