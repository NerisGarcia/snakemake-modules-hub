import os

# One FASTA alignment path per line; the gene ID is the file name without its last extension.
alignment_list = config["alignment_list"]
# Samples (and order) of the final alignment; genes missing a sample are padded with gaps.
sample_list = config["sample_list"]
output_dir = config["output_dir"]
prefix = config["prefix"]

min_variable_sites = config.get("min_variable_sites", 5)
gap_seq_max = config.get("gap_seq_max", 0.8)
hmmcleaner_args = (config.get("hmmcleaner") or {}).get(
    "extra_args", "--large -profile=leave-one-out"
)

manifest_file = f"{output_dir}/gene_alignments.tsv"
filtered_dir = f"{output_dir}/gappy_filtered"
removed_dir = f"{output_dir}/removed_sequences"
mafft_dir = f"{output_dir}/mafft"
hmmcleaner_dir = f"{output_dir}/hmmcleaner"
final_alignment_dir = f"{output_dir}/cleaned_gene_alignments"
amas_dir = f"{output_dir}/amas"
log_dir = f"{output_dir}/logs"
concat_alignment = f"{output_dir}/{prefix}.gene_alignment.aln"
partitions_file = f"{amas_dir}/{prefix}.partitions.txt"
summary_file = f"{amas_dir}/amas_alignment_summary.tsv"
variable_genes = f"{output_dir}/variable_genes.txt"
constant_genes = f"{output_dir}/constant_genes.txt"


rule all:
    input:
        concat_alignment,
        partitions_file,
        summary_file


# The list may be produced by another rule, so it is read only after it exists.
checkpoint read_alignment_list:
    input:
        alignment_list=alignment_list
    output:
        manifest_file
    log:
        f"{log_dir}/read_alignment_list.log"
    run:
        genes = {}
        with open(input.alignment_list) as handle:
            for line in handle:
                path = line.strip()
                if not path or path.startswith("#"):
                    continue
                gene = os.path.splitext(os.path.basename(path))[0]
                if gene in genes:
                    raise ValueError(f"Duplicate gene ID {gene}: {genes[gene]} and {path}")
                if not os.path.isfile(path):
                    raise FileNotFoundError(f"Alignment not found: {path}")
                genes[gene] = path
        if not genes:
            raise ValueError(f"No alignments listed in {input.alignment_list}")
        os.makedirs(os.path.dirname(output[0]), exist_ok=True)
        with open(output[0], "w") as out:
            out.writelines(f"{gene}\t{path}\n" for gene, path in genes.items())


def alignment_paths():
    with open(checkpoints.read_alignment_list.get().output[0]) as handle:
        return dict(line.rstrip("\n").split("\t") for line in handle if line.strip())


def source_alignment(wildcards):
    return alignment_paths()[wildcards.gene]


def final_gene_alignments(wildcards):
    # classify_genes must finish before per-gene inputs are resolved
    checkpoints.classify_genes.get()
    return expand(f"{final_alignment_dir}/{{gene}}.fasta", gene=list(alignment_paths()))


checkpoint classify_genes:
    input:
        manifest=manifest_file
    output:
        variable=variable_genes,
        constant=constant_genes
    params:
        min_variable_sites=min_variable_sites
    log:
        f"{log_dir}/classify_genes.log"
    script:
        "scripts/classify_genes.py"


def is_variable(gene):
    with open(checkpoints.classify_genes.get().output.variable) as handle:
        return gene in {line.strip() for line in handle}


def gene_alignment_source(wildcards):
    if is_variable(wildcards.gene):
        return f"{hmmcleaner_dir}/{wildcards.gene}.fasta"
    return source_alignment(wildcards)


# Only genes with >= min_variable_sites variable columns are cleaned and realigned.
rule remove_gappy_sequences:
    input:
        alignment=source_alignment
    output:
        fasta=temp(f"{filtered_dir}/{{gene}}.fasta"),
        removed=f"{removed_dir}/{{gene}}.tsv"
    params:
        gap_seq_max=gap_seq_max
    log:
        f"{log_dir}/remove_gappy_sequences/{{gene}}.log"
    script:
        "scripts/remove_gappy_sequences.py"


rule mafft_per_gene:
    input:
        fasta=f"{filtered_dir}/{{gene}}.fasta"
    output:
        alignment=temp(f"{mafft_dir}/{{gene}}.fasta")
    threads: config["threads"]
    log:
        f"{log_dir}/mafft/{{gene}}.log"
    conda:
        "gene_aln.yaml"
    shell:
        # strip the _R_ prefix MAFFT adds to reverse-complemented sequences
        r"""
        mafft --adjustdirection --auto --thread {threads} {input.fasta} 2> {log} \
            | sed 's/^>_R_/>/' > {output.alignment}
        """


# HmmCleaner only works from the alignment's directory and writes its outputs
# there (<stem>_hmm.*), so each gene runs in its own scratch directory.
rule hmmcleaner_per_gene:
    input:
        alignment=f"{mafft_dir}/{{gene}}.fasta"
    output:
        alignment=temp(f"{hmmcleaner_dir}/{{gene}}.fasta")
    params:
        extra_args=hmmcleaner_args,
        work_dir=f"{hmmcleaner_dir}/work_{{gene}}"
    log:
        f"{log_dir}/hmmcleaner/{{gene}}.log"
    shell:
        r"""
        rm -rf {params.work_dir:q}
        mkdir -p {params.work_dir:q} "$(dirname {log:q})"
        cp {input.alignment:q} {params.work_dir:q}/aln.fasta
        (cd {params.work_dir:q} && HmmCleaner.pl aln.fasta {params.extra_args}) > {log:q} 2>&1
        mv {params.work_dir:q}/aln_hmm.fasta {output.alignment:q}
        rm -rf {params.work_dir:q}
        """


rule prepare_gene_alignment:
    input:
        alignment=gene_alignment_source,
        samples=sample_list
    output:
        alignment=f"{final_alignment_dir}/{{gene}}.fasta"
    log:
        f"{log_dir}/prepare_gene_alignment/{{gene}}.log"
    script:
        "scripts/prepare_gene_alignment.py"


rule amas_concatenate:
    input:
        alignments=final_gene_alignments
    output:
        alignment=concat_alignment,
        partitions=partitions_file
    log:
        f"{log_dir}/amas_concatenate.log"
    conda:
        "gene_aln.yaml"
    shell:
        "AMAS.py concat -i {input.alignments} -f fasta -d dna -t {output.alignment} -p {output.partitions} > {log} 2>&1"


rule amas_summary:
    input:
        alignments=final_gene_alignments
    output:
        summary=summary_file
    params:
        amas_dir=amas_dir
    log:
        f"{log_dir}/amas_summary.log"
    conda:
        "gene_aln.yaml"
    shell:
        r"""
        mkdir -p "{params.amas_dir}"
        AMAS.py summary -i {input.alignments} -f fasta -d dna -o {output.summary} > {log} 2>&1
        """
