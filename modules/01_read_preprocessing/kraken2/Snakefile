sample_file = config["sample_file"]
input_dir = config["input_dir"]
read_pattern = config["pairend_extension_pattern"]
extension = config["input_extension"]
kraken_dir = f'{config["out_dir"]}/kraken2'

if "{read}" not in read_pattern:
    raise ValueError("pairend_extension_pattern must contain {read}")


def kraken_targets(wildcards):
    with open(sample_file) as handle:
        samples = [line.strip() for line in handle if line.strip() and not line.lstrip().startswith("#")]
    if not samples or len(samples) != len(set(samples)):
        raise ValueError(f"sample_file must contain unique sample IDs: {sample_file}")
    return expand(f"{kraken_dir}/{{sample}}_bracken_{config['bracken_level']}.tsv", sample=samples)


rule all:
    input:
        kraken_targets

rule kraken2:
    input:
        r1=f"{input_dir}/{{sample}}{read_pattern.replace('{read}', '1')}{extension}",
        r2=f"{input_dir}/{{sample}}{read_pattern.replace('{read}', '2')}{extension}"
    output:
        report=f"{kraken_dir}/{{sample}}_kraken2_report.txt"
    params:
        db_dir=config["kraken_db"],
        out_dir=kraken_dir,
        compression="--gzip-compressed" if extension.endswith(".gz") else ""
    threads: config["threads"]
    conda:
        "kraken2.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        kraken2 --db {params.db_dir} --threads {threads} --paired \
            --report {output.report} --output /dev/null \
            {params.compression} {input.r1:q} {input.r2:q}
        """

    
# Bracken needs a Kraken2 database on which bracken-build was already run for this read length
rule bracken:
    input:
        report=f"{kraken_dir}/{{sample}}_kraken2_report.txt"
    output:
        bracken=f"{kraken_dir}/{{sample}}_bracken_{config['bracken_level']}.tsv",
        bracken_report=f"{kraken_dir}/{{sample}}_bracken_{config['bracken_level']}_report.txt"
    params:
        db_dir=config["kraken_db"],
        read_len=config["bracken_read_len"],
        level=config["bracken_level"],
        threshold=config["bracken_threshold"]
    conda:
        "kraken2.yaml"
    shell:
        """
        bracken -d {params.db_dir} -i {input.report} -o {output.bracken} \
            -w {output.bracken_report} -r {params.read_len} \
            -l {params.level} -t {params.threshold}
        """