sample_file = config["sample_file"]
input_dir = config["input_dir"]
read_pattern = config["pairend_extension_pattern"]
extension = config["input_extension"]
unpaired_pattern = config.get("unpaired_input_pattern")
cleanifier_dir = f'{config["out_dir"]}/cleanifier'
cleanifier_index = config["cleanifier_index"]

if "{read}" not in read_pattern:
    raise ValueError("pairend_extension_pattern must contain {read}")
if unpaired_pattern and "{sample}" not in unpaired_pattern:
    raise ValueError("unpaired_input_pattern must contain {sample}")


def cleanifier_targets(wildcards):
    with open(sample_file) as handle:
        samples = [line.strip() for line in handle if line.strip() and not line.lstrip().startswith("#")]
    if not samples or len(samples) != len(set(samples)):
        raise ValueError(f"sample_file must contain unique sample IDs: {sample_file}")
    targets = expand(f"{cleanifier_dir}/{{sample}}.cleanifier.R{{read}}.fastq.gz", sample=samples, read=[1, 2])
    if unpaired_pattern:
        targets += expand(f"{cleanifier_dir}/{{sample}}.cleanifier.unpaired.fastq.gz", sample=samples)
    return targets + expand(f"{cleanifier_dir}/qc/{{sample}}.cleanifier.seqkit_stats.txt", sample=samples)


rule all:
    input:
        cleanifier_targets


rule cleanifier_paired:
    input:
        r1=f"{input_dir}/{{sample}}{read_pattern.replace('{read}', '1')}{extension}",
        r2=f"{input_dir}/{{sample}}{read_pattern.replace('{read}', '2')}{extension}"
    output:
        r1=f"{cleanifier_dir}/{{sample}}.cleanifier.R1.fastq.gz",
        r2=f"{cleanifier_dir}/{{sample}}.cleanifier.R2.fastq.gz"
    params:
        index=cleanifier_index,
        prefix=f"{cleanifier_dir}/{{sample}}.cleanifier"
    conda:
        "environment.yaml"
    threads: config["threads"]
    shell:
        """
        cleanifier filter --index {params.index:q} -T {threads} --compression gz \
            --compression-threads {threads} --compression-level 9 --threshold 0.5 \
            --fastq {input.r1:q} --pairs {input.r2:q} --out {params.prefix:q}
        mv {params.prefix:q}_1_keep.fq.gz {output.r1:q}
        mv {params.prefix:q}_2_keep.fq.gz {output.r2:q}
        """


if unpaired_pattern:
    rule cleanifier_unpaired:
        input:
            un=f"{input_dir}/{unpaired_pattern}{extension}"
        output:
            un=f"{cleanifier_dir}/{{sample}}.cleanifier.unpaired.fastq.gz"
        params:
            index=cleanifier_index,
            prefix=f"{cleanifier_dir}/{{sample}}.cleanifier.unpaired"
        conda:
            "environment.yaml"
        threads: config["threads"]
        shell:
            """
            cleanifier filter --index {params.index:q} -T {threads} --compression gz \
                --compression-threads {threads} --compression-level 9 --threshold 0.5 \
                --fastq {input.un:q} --out {params.prefix:q}
            mv {params.prefix:q}_keep.fq.gz {output.un:q}
            """


rule cleanifier_analytics:
    input:
        paired=expand(f"{cleanifier_dir}/{{{{sample}}}}.cleanifier.R{{read}}.fastq.gz", read=[1, 2]),
        unpaired=f"{cleanifier_dir}/{{sample}}.cleanifier.unpaired.fastq.gz" if unpaired_pattern else []
    output:
        stats=f"{cleanifier_dir}/qc/{{sample}}.cleanifier.seqkit_stats.txt"
    conda:
        "environment.yaml"
    shell:
        "seqkit stats {input:q} > {output.stats:q}"
