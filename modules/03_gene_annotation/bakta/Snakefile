import os

annotation_dir = config["annotation_dir"]
bakta_db = config["bakta_db"]

EXTENSIONS = (".fasta", ".fna", ".fa", ".fas", ".fasta.gz", ".fna.gz", ".fa.gz")

def sample_name(path):
    base = os.path.basename(path)
    for ext in EXTENSIONS:
        if base.endswith(ext):
            return base[: -len(ext)]
    raise ValueError(f"Unrecognised fasta extension: {path}")

# Optional: a file with one fasta path per line. Without it, fall back to shovill contigs in assembly_dir.
GENOMES = {}
if config.get("genomes_list"):
    with open(config["genomes_list"]) as handle:
        paths = [l.strip() for l in handle if l.strip() and not l.lstrip().startswith("#")]
    GENOMES = {sample_name(p): p for p in paths}
    if len(GENOMES) != len(paths):
        raise ValueError("Duplicate sample names in genomes_list")

def assembly_input(wildcards):
    if GENOMES:
        return GENOMES[wildcards.sample]
    sample = wildcards.sample
    return f"{config['assembly_dir']}/{sample}_shovill/{sample}.contigs.fa"

rule bakta:
    input:
        contigs=assembly_input
    output:
        gff3=f"{annotation_dir}/{{sample}}_bakta/{{sample}}.gff3",
        fna=f"{annotation_dir}/{{sample}}_bakta/{{sample}}.fna"
    params:
        out_dir=f"{annotation_dir}/{{sample}}_bakta",
        prefix="{sample}",
        bakta_db=bakta_db
    threads: config["threads"]
    conda:
        "cenv.bakta.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        bakta --db {params.bakta_db} --output {params.out_dir} \
            --prefix {params.prefix} --locus-tag {params.prefix} \
            --threads {threads} {input.contigs} --keep-contig-headers --force
        """


rule bakta_cleanup:
    input:
        gff3=f"{annotation_dir}/{{sample}}_bakta/{{sample}}.gff3",
        fna=f"{annotation_dir}/{{sample}}_bakta/{{sample}}.fna"
    output:
        gff3=f"{annotation_dir}/{{sample}}.gff3",
        fna=f"{annotation_dir}/{{sample}}.fna"
    params:
        out_dir=f"{annotation_dir}/{{sample}}_bakta",
        prefix="{sample}"
    shell:
        """
        bakta_dir=$(cd "{params.out_dir}" && pwd)
        gff3_path=$(find "$bakta_dir" -type f -name "{params.prefix}.gff3" -print -quit)
        fna_path=$(find "$bakta_dir" -type f -name "{params.prefix}.fna" -print -quit)
        test -n "$gff3_path" && test -n "$fna_path"
        ln -sfn "$gff3_path" "{output.gff3}"
        ln -sfn "$fna_path" "{output.fna}"

        rm -f {params.out_dir}/{params.prefix}.embl \
              {params.out_dir}/{params.prefix}.png \
              {params.out_dir}/{params.prefix}.svg \
              {params.out_dir}/{params.prefix}.hypotheticals.faa \
              {params.out_dir}/{params.prefix}.hypotheticals.tsv
        """
