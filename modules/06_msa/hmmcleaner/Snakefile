
INPUT_FILE = config["input_file"]

RESULTS_DIR = f"{config['out_dir']}"


rule all:
    input:
        RESULTS_DIR


# HmmCleaner only works when run from the alignment's directory and writes its
# outputs (<stem>_hmm.*) there, so they are moved to the output directory.
rule hmmcleaner:
    input:
        alignment=INPUT_FILE
    output:
        results=directory(RESULTS_DIR)
    threads: 1
    shell:
        r"""
        mkdir -p {output.results:q} "$(dirname {log:q})"
        exec > {log:q} 2>&1

        in_dir=$(dirname {input.alignment:q})
        name=$(basename {input.alignment:q})
        stem="${{name%.*}}"

        (cd "$in_dir" && HmmCleaner.pl "$name" --large -profile=leave-one-out)

        mv "$in_dir/${{stem}}"_hmm* {output.results:q}/
        """