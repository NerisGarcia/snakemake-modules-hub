in_dir = config["in_dir"]
out_dir = config["out_dir"]
db_dir = config["db_dir"]
gtdbtk_cfg = config["gtdbtk"]
samples = [l.strip() for l in open(config["sample_file"]) if l.strip()]

rule gtdbtk_classify:
    input:
        genomes=expand(f"{in_dir}/{{sample}}.{gtdbtk_cfg['extension']}", sample=samples)
    output:
        summary=f"{out_dir}/gtdbtk.bac120.summary.tsv"
    params:
        out_dir=out_dir,
        db=db_dir,
        ext=gtdbtk_cfg["extension"],
        skip_ani="--skip_ani_screen" if gtdbtk_cfg["skip_ani_screen"] else "",
        pplacer_cpus=gtdbtk_cfg["pplacer_cpus"],
        extra=gtdbtk_cfg["extra_args"]
    threads: config["threads"]
    conda:
        "envs/cenv.gtdbtk.yaml"
    shell:
        """
        export GTDBTK_DATA_PATH="{params.db}"
        mkdir -p "{params.out_dir}"
        batch="{params.out_dir}/batchfile.tsv"
        : > "$batch"
        for g in {input.genomes}; do
            printf '%s\\t%s\\n' "$g" "$(basename "$g" .{params.ext})" >> "$batch"
        done
        gtdbtk classify_wf --batchfile "$batch" --out_dir "{params.out_dir}" \
            --cpus {threads} --pplacer_cpus {params.pplacer_cpus} \
            {params.skip_ani} {params.extra}
        """
