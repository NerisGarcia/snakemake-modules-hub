FASTQ_DIR = config['fastq_dir']

OUT_DIR = config['out_dir']

ASSEMBLY_DIR = f'{OUT_DIR}/MAGS/01_assembly'
METABAT_DIR = f'{OUT_DIR}/MAGS/05_binning/MetaBat'
MAXBIN_DIR = f'{OUT_DIR}/MAGS/05_binning/MaxBin'
COMEBIN_DIR = f'{OUT_DIR}/MAGS/05_binning/ComeBin'


# assembly 

rule assembly:
    input:
        r1 = f'{FASTQ_DIR}/{sample}.R1.clean.fastq.gz',
        r2 = f'{FASTQ_DIR}/{sample}.R2.clean.fastq.gz',
        un = f'{FASTQ_DIR}/{sample}.unpaired.fastq.gz'
    output:
        outdir = f'{ASSEMBLY_DIR}/{sample}/{sample}.contigs.fa'
    threads: 
        threads = config['spades_threads'],
    params:
        memorylimit = config['spades_memory_limit']
    shell:
        """
        spades.py --meta -o {output.outdir} -1 {input.r1} -2 {input.r2} -s {input.un} -t {threads.threads} -m {params.memorylimit}
        """

rule clean_assembly_dir:
    input:
        outdir = f'{ASSEMBLY_DIR}/{sample}/{sample}.contigs.fa'
    params:
        sample = sample
    shell:
        """
            rm -r ${params.sample}/${params.sample}.corrected

        """


#metabat

rule bowtie_build_contigs:
    input:
        contigs = f'{ASSEMBLY_DIR}/{sample}/{sample}.contigs.fa'
    output:
        index = temp(f'{METABAT_DIR}/{sample}/{sample}.contigs.fa.bwt')
    shell:
        """
        bowtie2-build {input.contigs} {output.index}
        """
    

rule metabat_map_reads2contigs:
    input:
        r1 = f'{FASTQ_DIR}/{sample}.R1.clean.fastq.gz',
        r2 = f'{FASTQ_DIR}/{sample}.R2.clean.fastq.gz',
        un = f'{FASTQ_DIR}/{sample}.unpaired.fastq.gz',
        contigs = f'{ASSEMBLY_DIR}/{sample}/{sample}.contigs.fa',
        index = f'{METABAT_DIR}/{sample}/{sample}.contigs.fa.bwt'
    output:
        sam = temp(f'{METABAT_DIR}/{sample}/{sample}.sam')
    threads:
        threads = config['metabat_threads'],
    shell:
        """
        bowtie2 --threads {threads.threads} -x {input.index} -1 {input.r1} -2 {input.r2} -U {input.un} -S {output.sam}
        """

