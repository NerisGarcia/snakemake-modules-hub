
sample_file = config["sample_file"]
raw_dir = config["raw_dir"]
read_pattern = config["pairend_extension_pattern"]
extension = config["input_extension"]
assembly_dir = f'{config["out_dir"]}/shovill'

if "{read}" not in read_pattern:
    raise ValueError("pairend_extension_pattern must contain {read}")


def assembly_targets(wildcards):
    with open(sample_file) as handle:
        samples = [line.strip() for line in handle if line.strip() and not line.lstrip().startswith("#")]
    if not samples or len(samples) != len(set(samples)):
        raise ValueError(f"sample_file must contain unique sample IDs: {sample_file}")
    return expand(f"{assembly_dir}/{{sample}}.contigs.fa", sample=samples)


rule all:
    input:
        assembly_targets

rule shovill:
    input:
        r1=f"{raw_dir}/{{sample}}{read_pattern.replace('{read}', '1')}{extension}",
        r2=f"{raw_dir}/{{sample}}{read_pattern.replace('{read}', '2')}{extension}"
    output:
        contigs=f"{assembly_dir}/{{sample}}_shovill/{{sample}}.contigs.fa"
    params:
        out_dir=f"{assembly_dir}/{{sample}}_shovill"
    threads: config["threads"]
    conda:
        "shovill.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        shovill --R1 {input.r1} --R2 {input.r2} \
            --outdir {params.out_dir} --cpus {threads} --force
        
        mv {params.out_dir}/contigs.fa {output.contigs}

        """


rule shovill_flat_contigs:
    input:
        contigs=f"{assembly_dir}/{{sample}}_shovill/{{sample}}.contigs.fa"
    output:
        contigs=f"{assembly_dir}/{{sample}}.contigs.fa"
    run:
        import os

        target = os.path.relpath(input.contigs, os.path.dirname(output.contigs))
        if os.path.lexists(output.contigs):
            os.unlink(output.contigs)
        os.symlink(target, output.contigs)