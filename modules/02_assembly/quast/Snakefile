
sample_file = config["sample_file"]
raw_dir = config["raw_dir"]
input_extension = config["input_extension"]
quast_output = f'{config["out_dir"]}/QUAST'

def quast_targets(wildcards):
    with open(sample_file) as handle:
        samples = [
            line.strip()
            for line in handle
            if line.strip() and not line.lstrip().startswith("#")
        ]
    if not samples:
        raise ValueError(f"sample_file is empty: {sample_file}")
    if len(samples) != len(set(samples)):
        raise ValueError(f"sample_file contains duplicate identifiers: {sample_file}")
    return expand(
        f"{quast_output}/{{sample}}.quast.transposed_report.tsv", sample=samples
    )


rule all:
    input:
        quast_targets


rule assembly_qc_sample:
    input:
        f"{raw_dir}/{{sample}}{input_extension}"
    output:
        f"{quast_output}/{{sample}}.quast.transposed_report.tsv"
    conda:
        "quast.yaml"
    params:
        out_dir = f"{quast_output}/{{sample}}_quast"
    threads: config["threads"]
    shell:
        r'''
        quast.py {input} -o {params.out_dir} --threads {threads} --glimmer --no-sv --no-icarus --no-plots --min-contig 200

        mv {params.out_dir}/transposed_report.tsv {output}
        rm -rf {params.out_dir}
        '''
